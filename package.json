{
  "name": "marketplace-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens:build": "node packages/tokens/build.mjs",
    "test": "node --test lib/productOptions.test.mjs lib/shopRules.test.mjs lib/storeRules.test.mjs lib/noVendors.test.mjs lib/integrationGuides.test.mjs lib/legalPages.test.mjs lib/productPage.test.mjs lib/importRows.test.mjs lib/brandName.test.mjs lib/productForm.test.mjs",
    "dev": "npm run tokens:build && next dev",
    "build": "npm run tokens:build && next build --webpack",
    "start": "next start",
    "backend": "cd laravel-backend && \"C:\\laragon\\bin\\php\\php-8.3.30-Win32-vs16-x64\\php.exe\" artisan serve --port=8001",
    "backend:migrate": "cd laravel-backend && \"C:\\laragon\\bin\\php\\php-8.3.30-Win32-vs16-x64\\php.exe\" artisan migrate",
    "backend:reset": "cd laravel-backend && \"C:\\laragon\\bin\\php\\php-8.3.30-Win32-vs16-x64\\php.exe\" artisan migrate:fresh --seed",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev\" \"npm run backend\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
