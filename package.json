    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.417.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3"
  }
