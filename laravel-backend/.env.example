APP_NAME="My Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Email ────────────────────────────────────────────────────────────────
# log = write emails to the log, send nothing. To send real email use SMTP with
# any provider (Amazon SES, Brevo, Mailgun, Resend, Gmail...). All of this can
# instead be set from Admin -> Integrations -> Email, which then wins.
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Must be an address your provider has verified.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── SMS and phone sign-in ────────────────────────────────────────────────
# log = send nothing. In production the phone-OTP sign-in then refuses instead of
# pretending to send. msg91 suits Indian numbers (DLT templates); twilio is free
# text and works worldwide. Also settable from Admin -> Integrations -> SMS.
SMS_DRIVER=log
# SMS_ORDER_UPDATES=off
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_OTP=
# MSG91_TEMPLATE_ORDER=
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# ── Image and file storage ───────────────────────────────────────────────
# local keeps uploads on this server's disk (lost if you move servers). s3 uses
# Amazon S3 or any S3-compatible service (Cloudflare R2, Backblaze B2, Spaces...).
# One bucket that allows public reads, for product images. Also settable from
# Admin -> Settings -> File storage; then run `php artisan media:migrate --apply`
# to move files uploaded before the switch.
STORAGE_DRIVER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# AWS_BUCKET=
# AWS_URL=https://cdn.yourshop.in
# AWS_ENDPOINT=

# Hosts typed into the admin panel (mail server, storage endpoint) must resolve to
# a public address. Set true ONLY for a self-hosted setup on a private network.
# Deliberately not settable from the admin panel.
# INTEGRATIONS_ALLOW_PRIVATE_HOSTS=false

# ── Error tracking (Sentry) ──────────────────────────────────────────────
# Leave blank to switch it off. Reports have keys, passwords, cookies and request
# bodies removed before they leave the server. Test it with: php artisan sentry:test
SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=          # defaults to the deployed git commit
# SENTRY_TRACES_SAMPLE_RATE=   # performance tracing: off unless set (e.g. 0.05)

VITE_APP_NAME="${APP_NAME}"

# ── Payments ─────────────────────────────────────────────────────────────
# rzp_test_… keys are Razorpay Test Mode (no real money); rzp_live_… take real
# payments. Leave both blank to run without a real gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in the Razorpay dashboard.
# Without it every webhook is refused.
RAZORPAY_WEBHOOK_SECRET=

# Optional: which gateway new payments use when several are configured.
PAYMENT_GATEWAY=

# The sandbox gateway approves every payment without taking any money. It is on
# for local/testing and OFF in production (prepaid checkout then says "not
# available" until real keys are set; cash on delivery keeps working). Set to
# true only for a deliberately fake demo deployment.
PAYMENTS_ALLOW_SANDBOX=

# Minutes before a payment that was captured but never became an order is
# refunded automatically (needs the scheduler running — see docs/PAYMENTS.md).
PAYMENT_UNCLAIMED_REFUND_MINUTES=30

# ── AI features (optional; the app falls back to built-in behaviour without it)
GEMINI_API_KEY=
